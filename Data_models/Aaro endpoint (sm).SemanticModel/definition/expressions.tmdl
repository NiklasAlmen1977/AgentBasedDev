		  #"Filtered rows 1" = Table.SelectRows(Source, each Text.EndsWith([Folder Path], p_sharepoint_folder_path)),
		  #"Filtered rows" = Table.SelectRows(#"Filtered rows 1", each [Name] = "rls_aaro_endpoint_validation.xlsx"),
		  Navigation = #"Filtered rows"{0}[Content],
		  #"Imported Excel workbook" = Excel.Workbook(Navigation, null, true),
		  #"Filtered rows 2" = Table.SelectRows(#"Imported Excel workbook", each ([Kind] = "Table") and ([Name] = "tbl_rls_gfo_aaro_access")),
		  #"Navigation 1" = #"Filtered rows 2"{0}[Data],
