	/// Link to the data product documentation (PDF of docs/Aaro endpoint (sm).md in the Group Analytics SharePoint folder), from the list column Documentation link.
	column 'Documentation link'
		dataType: string
		isHidden
		lineageTag: 5f75a036-556a-4177-92ae-70c0751ff135
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: Documentation link

		annotation SummarizationSetBy = Automatic

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["GA_HIDDEN_UNUSED_COLUMNS_REVIEW"]}

	partition '_Report Info' = m
		mode: import
		queryGroup: '5. Load to Data Model\Disconnected Tables'
		source =
				let
				    Source = src_sharepoint_analytics_report_info,
				
				    // Host of the SharePoint tenant, for example https://vitrolifeglobal.sharepoint.com
				    Get_SharePoint_Host = Text.BeforeDelimiter(p_analytics_metadata_site_root_path, "/sites/"),
				
				    // A SharePoint hyperlink column can arrive as a record with Url and Description: keep the Url.
				    // A link to the same tenant can arrive relative (/:b:/r/sites/...): add the host, so Power BI shows a clickable link.
				    Documentation_Link_As_Text =
				        Table.TransformColumns(
				            Source,
				            {{"Documentation link", each
				                let
				                    Get_Url = if _ is record then Record.FieldOrDefault(_, "Url", null) else _
				                in
				                    if Get_Url is text and Text.StartsWith(Get_Url, "/") then Get_SharePoint_Host & Get_Url else Get_Url,
				              type text}}
				        ),
				
				    // Only the columns the Definition page uses
				    Select_Columns =
				        Table.SelectColumns(
				            Documentation_Link_As_Text,
				            {"Report owner", "Target owner", "Report", "Semantic model", "Report refresh frequency", "Report overview", "Data model description", "Refinement needed?", "Found error?", "Developer responsible", "Message", "Documentation link"}
				        )
				in
				    Select_Columns

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

